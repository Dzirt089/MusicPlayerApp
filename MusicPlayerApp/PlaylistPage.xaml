<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicPlayerApp.PlaylistPage"
             Title="Плейлист">

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Заголовок -->
		<Label Grid.Row="0"
               Text="Мой плейлист"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Margin="0,10,0,20"/>

		<!-- Список треков -->
		<CollectionView x:Name="playlistCollection"
                        Grid.Row="1"
                        SelectionMode="Single">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Grid Padding="15,10" 
                          ColumnDefinitions="Auto,*,Auto">

						<Label Grid.Column="0"
                               Text="🎵"
                               FontSize="16"
                               VerticalTextAlignment="Center"/>

						<VerticalStackLayout Grid.Column="1" 
                                             Spacing="2">
							<Label Text="{Binding Name}"
                                   FontSize="16"/>
							<Label Text="{Binding Duration}"
                                   FontSize="12"
                                   TextColor="Gray"/>
						</VerticalStackLayout>

						<Label Grid.Column="2"
                               Text="▶"
                               FontSize="14"
                               VerticalTextAlignment="Center"
                               TextColor="#4ECDC4"/>
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<!-- Кнопки -->
		<Button Grid.Row="2"
                Text="Назад"
                CornerRadius="10"
                HeightRequest="45"
                Margin="20"
                Clicked="OnBackClicked"/>
	</Grid>
</ContentPage>